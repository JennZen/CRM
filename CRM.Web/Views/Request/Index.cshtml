@using CRM.Domain.Enums
@model RequestIndexViewModel;

@{
    ViewData["Title"] = "Requests";
}

@functions {
    string StatusBadgeClass(Status status) => status switch
    {
        Status.New => "badge-new",
        Status.Active => "badge-progress",
        Status.Finished => "badge-finished",
        Status.Solved => "badge-done",
        Status.Rejected => "badge-rejected",
        _ => "badge-new"
    };

    string PriorityBadgeClass(Priority priority) => priority switch
    {
        Priority.High => "priority-high",
        Priority.Medium => "priority-medium",
        Priority.Low => "priority-low",
        _ => "priority-medium"
    };
}

<style>
    :root {
        --bg: #f2efe8;
        --card: #ffffff;
        --ink: #1c1b19;
        --muted: #7a766e;
        --line: #e7e2d8;
        --green: #4b7a5a;
        --green-bg: #e6efe4;
        --amber: #a9812f;
        --amber-bg: #f4ecd8;
        --blue-bg: #e8ecf5;
        --blue: #4a5a8a;
        --red: #a94b3f;
        --red-bg: #f4e2de;
        --gray: #6f6b64;
        --gray-bg: #eeece5;
        --teal: #2f7a78;
        --teal-bg: #e2efee;
    }

    body {
        background: var(--bg);
        color: var(--ink);
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--green);
        font-weight: 600;
        margin-bottom: .5rem;
    }

        .eyebrow .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
        }

    .page-title {
        font-weight: 500;
        font-size: 2.1rem;
    }

    .subtitle {
        color: var(--muted);
        font-size: .95rem;
    }

    .btn-dark-soft {
        background: #1c1b19;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-size: .9rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        white-space: nowrap;
    }

        .btn-dark-soft:hover {
            background: #000;
            color: #fff;
        }

    .filter-tabs {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .filter-tab {
        background: var(--card);
        border: 1px solid var(--line);
        color: var(--ink);
        border-radius: 999px;
        padding: .45rem 1rem;
        font-size: .85rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

        .filter-tab:hover {
            background: #f7f5f0;
        }

        .filter-tab.active {
            background: var(--green-bg);
            color: var(--green);
            border-color: #b9ceb5;
            font-weight: 600;
        }

    .req-table-wrap {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    table.req-table {
        width: 100%;
        border-collapse: collapse;
    }

        table.req-table thead th {
            text-align: left;
            font-size: .7rem;
            letter-spacing: .05em;
            text-transform: uppercase;
            color: var(--muted);
            font-weight: 600;
            padding: .9rem 1.4rem;
            border-bottom: 1px solid var(--line);
            background: var(--bg);
            white-space: nowrap;
        }

        table.req-table tbody td {
            padding: 1rem 1.4rem;
            border-bottom: 1px solid var(--line);
            font-size: .9rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        table.req-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.req-table tbody tr:hover {
            background: #faf9f5;
        }

    .req-subject {
        font-weight: 600;
    }

    .req-client {
        color: var(--ink);
    }

    .req-updated {
        color: var(--muted);
    }

    .req-title-link,
    .req-title-link:hover,
    .req-title-link:focus,
    .req-title-link:active,
    .req-title-link:visited {
        color: inherit;
        text-decoration: none;
        outline: none;
        box-shadow: none;
    }

        .req-title-link:hover {
            text-decoration: underline;
        }

    .badge-finished {
        background: var(--teal-bg);
        color: var(--teal);
    }

        .badge-finished .dot {
            background: var(--teal);
        }

    .badge-rejected {
        background: var(--red-bg);
        color: var(--red);
    }

        .badge-rejected .dot {
            background: var(--red);
        }

    .badge-status {
        font-size: .76rem;
        font-weight: 500;
        padding: .3rem .65rem;
        border-radius: 999px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
    }

        .badge-status .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: .35rem;
            display: inline-block;
        }

    .badge-new {
        background: var(--blue-bg);
        color: var(--blue);
    }

        .badge-new .dot {
            background: var(--blue);
        }

    .badge-progress {
        background: var(--amber-bg);
        color: var(--amber);
    }

        .badge-progress .dot {
            background: var(--amber);
        }

    .badge-done {
        background: var(--green-bg);
        color: var(--green);
    }

        .badge-done .dot {
            background: var(--green);
        }

    .badge-closed {
        background: var(--gray-bg);
        color: var(--gray);
    }

        .badge-closed .dot {
            background: var(--gray);
        }

    .badge-priority {
        font-size: .74rem;
        font-weight: 500;
        padding: .25rem .6rem;
        border-radius: 6px;
        white-space: nowrap;
    }

    .priority-high {
        background: var(--red-bg);
        color: var(--red);
    }

    .priority-medium {
        background: var(--amber-bg);
        color: var(--amber);
    }

    .priority-low {
        background: var(--gray-bg);
        color: var(--gray);
    }

    #newRequestModal .modal-content {
        background: var(--bg);
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #newRequestModal .modal-header-custom {
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid var(--line);
        position: relative;
    }

    #newRequestModal .modal-title-custom {
        font-weight: 500;
        font-size: 1.6rem;
        margin: 0 0 .3rem;
    }

    #newRequestModal .modal-subtitle {
        color: var(--muted);
        font-size: .9rem;
    }

    #newRequestModal .modal-close-btn {
        position: absolute;
        top: 1.25rem;
        right: 1.5rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #ebe8e0;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #newRequestModal .modal-close-btn:hover {
            background: #e0ddd3;
        }

    #newRequestModal .modal-body {
        padding: 1.5rem 1.75rem;
    }

    #newRequestModal .field-label {
        font-size: .72rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        margin-bottom: .5rem;
        display: block;
    }

        #newRequestModal .field-label .req {
            color: var(--red);
        }

    #newRequestModal .form-control,
    #newRequestModal .form-select {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .65rem .9rem;
        font-size: .92rem;
        color: var(--ink);
    }

        #newRequestModal .form-control:focus,
        #newRequestModal .form-select:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px var(--green-bg);
        }

    #newRequestModal textarea.form-control {
        resize: vertical;
        min-height: 90px;
    }

    #newRequestModal .field-group {
        margin-bottom: 1.25rem;
    }

    #newRequestModal .hint-note {
        font-size: .82rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        #newRequestModal .hint-note .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
            flex-shrink: 0;
        }

    #newRequestModal .modal-footer-custom {
        padding: 1.1rem 1.75rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

    #newRequestModal .btn-cancel {
        background: var(--gray-bg);
        color: var(--ink);
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
    }

        #newRequestModal .btn-cancel:hover {
            background: #e2ded3;
        }

    #newRequestModal .btn-save {
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
        font-weight: 500;
    }

        #newRequestModal .btn-save:hover {
            background: #3f6a4c;
        }
</style>

<div class="container-fluid px-0" style="max-width:1200px;">

    <div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
        <div>
            <div class="eyebrow"><span class="dot"></span>@Model.NumberOfRequests requests</div>
            <div class="page-title">Requests</div>
            <div class="subtitle">Customer inquiries and their processing status.</div>
        </div>
        <button class="btn-dark-soft" type="button" data-bs-toggle="modal" data-bs-target="#newRequestModal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M12 5v14M5 12h14" /></svg>
            New request
        </button>
    </div>

    <div class="filter-tabs">
        <a asp-action="Index" asp-route-status="" class="filter-tab @(Model.CurrentStatus == null ? "active" : "")">All</a>
        <a asp-action="Index" asp-route-status="New" class="filter-tab @(Model.CurrentStatus == Status.New ? "active" : "")">New</a>
        <a asp-action="Index" asp-route-status="Active" class="filter-tab @(Model.CurrentStatus == Status.Active ? "active" : "")">Active</a>
        <a asp-action="Index" asp-route-status="Finished" class="filter-tab @(Model.CurrentStatus == Status.Finished ? "active" : "")">Finished</a>
        <a asp-action="Index" asp-route-status="Solved" class="filter-tab @(Model.CurrentStatus == Status.Solved ? "active" : "")">Solved</a>
        <a asp-action="Index" asp-route-status="Rejected" class="filter-tab @(Model.CurrentStatus == Status.Rejected ? "active" : "")">Rejected</a>
    </div>

    @if (Model == null || Model.AllRequests.Count == 0)
    {
        <div class="text-center py-5">
            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.5"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 width="48"
                 height="48"
                 style="color: var(--muted); margin-bottom: 1rem;">

                <path d="M6 3h9l3 3v15H6z" />
                <path d="M15 3v4h4" />
                <path d="M9 12h6" />
                <path d="M9 16h4" />
            </svg>

            <div class="fs-5 fw-medium mb-1">No requests yet</div>
            <div class="subtitle mb-3">
                There are no customer requests to display.
            </div>
        </div>
    }
    else
    {
        <div class="req-table-wrap">
            <table class="req-table">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Manager</th>
                        <th>Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.AllRequests)
                    {
                        <tr>
                            <td class="req-subject">
                                <a asp-controller="Request" asp-action="Details" asp-route-id="@request.Id" class="req-title-link">
                                    @request.Title
                                </a>
                            </td>

                            <td class="req-client">@request.Customer</td>

                            <td>
                                <span class="badge-status @StatusBadgeClass(request.Status)">
                                    <span class="dot"></span>@request.Status
                                </span>
                            </td>

                            <td>
                                <span class="badge-priority @PriorityBadgeClass(request.Priority)">
                                    @request.Priority
                                </span>
                            </td>

                            <td>
                                @request.Manager
                            </td>

                            <td class="req-updated">
                                @request.UpdatedAt.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="newRequestModal" tabindex="-1" aria-labelledby="newRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="eyebrow"><span class="dot"></span>New request</div>
                <div class="modal-title-custom" id="newRequestModalLabel">New request</div>
                <div class="modal-subtitle">Customer inquiry for a manager to process.</div>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <form method="post" asp-controller="Request" asp-action="Create">
                <div class="modal-body">

                    <div class="field-group">
                        <label class="field-label" for="reqClient">Client <span class="req">*</span></label>
                        <select class="form-select" id="reqClient" name="CustomerId" asp-items="Model?.Customers" required>
                            <option value="">Select a client</option>
                        </select>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="reqSubject">Subject <span class="req">*</span></label>
                        <input type="text" class="form-control" id="reqSubject" name="Title" placeholder="Ex: Question about invoice" required />
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="reqDescription">Description</label>
                        <textarea class="form-control" id="reqDescription" name="Description" placeholder="Details of the inquiry..."></textarea>
                    </div>

                    <div class="row g-3 field-group">
                        <div class="col-6">
                            <label class="field-label" for="reqPriority">Priority</label>
                            <select class="form-select" id="reqPriority" name="Priority">
                                <option value="0">Low</option>
                                <option value="1" selected>Medium</option>
                                <option value="2">High</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="field-label" for="reqManager">Manager</label>
                            <select class="form-select" id="reqManager" name="ManagerId" asp-items="Model.Managers">
                                <option value="">Select a manager</option>
                            </select>
                        </div>
                    </div>

                    <div class="hint-note">
                        <span class="dot"></span>
                        New requests automatically get the "New" status
                    </div>

                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-save">Save request</button>
                </div>
            </form>

        </div>
    </div>
</div>
