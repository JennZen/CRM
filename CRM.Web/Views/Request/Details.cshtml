@model RequestDetailsViewModel;

@{
    ViewData["Title"] = $"Request: {Model.Request?.Title}";
}

<style>
    :root {
        --bg: #f6f2e9;
        --card-bg: #faf8f2;
        --border: #e6e0d2;
        --ink: #2b2a26;
        --muted: #8a8578;
        --accent-dark: #55712f;
        --pill-inactive-bg: #efeadb;
        --pill-inactive-fg: #6b6659;
        --pill-active-border: #6f8fd1;
        --pill-active-fg: #3f5fb0;
    }

    body {
        background: var(--bg);
        color: var(--ink);
    }

    .request-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 2px 24px 80px;
    }

    .back-link {
        font-size: .78rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
    }

        .back-link:hover {
            color: var(--ink);
        }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .75rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent-dark);
        margin: 20px 0 6px;
    }

        .eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
            display: inline-block;
        }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 20px;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 600;
        margin: 0;
    }

    .page-subtitle {
        color: var(--muted);
        font-size: .95rem;
        margin-top: 6px;
    }

    .btn-ghost {
        background: #fff;
        border: 1px solid var(--border);
        color: var(--ink);
        border-radius: 999px;
        padding: 10px 20px;
        font-size: .9rem;
        font-weight: 500;
    }

        .btn-ghost:hover {
            background: #f1ede2;
            color: var(--ink);
        }

    .btn-accent {
        background: var(--accent);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
    }

        .btn-accent:hover {
            background: var(--accent-dark);
            color: #fff;
        }

    .btn-cancel {
        background: #ece7d8;
        border: none;
        color: var(--ink);
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
    }

        .btn-cancel:hover {
            background: #e2ddcb;
        }

    .status-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 28px;
    }

    ```css
    .status-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .status-pill {
        border: 1px solid var(--border);
        background: var(--pill-inactive-bg);
        color: var(--pill-inactive-fg);
        border-radius: 999px;
        padding: 8px 18px;
        font-size: .85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all .18s ease;
    }

        .status-pill:hover {
            background: #fff;
            border-color: #d5cfbf;
            transform: translateY(-1px);
        }

        /* New */
        .status-pill:nth-child(1).active {
            background: #fff7dc;
            color: #9a7415;
            border-color: #e8d28a;
            box-shadow: 0 2px 8px rgba(154, 116, 21, .10);
        }

        /* Active */
        .status-pill:nth-child(2).active {
            background: #edf3ff;
            color: #4c6fb1;
            border-color: #b9cbed;
            box-shadow: 0 2px 8px rgba(76, 111, 177, .10);
        }

        /* Finished */
        .status-pill:nth-child(3).active {
            background: #edf6e8;
            color: #557a3d;
            border-color: #bdd5ac;
            box-shadow: 0 2px 8px rgba(85, 122, 61, .10);
        }

        /* Solved */
        .status-pill:nth-child(4).active {
            background: #f2edfa;
            color: #76589e;
            border-color: #cfbee6;
            box-shadow: 0 2px 8px rgba(118, 88, 158, .10);
        }

        /* Rejected */
        .status-pill:nth-child(5).active {
            background: #faeeee;
            color: #a45b5b;
            border-color: #e4c1c1;
            box-shadow: 0 2px 8px rgba(164, 91, 91, .10);
        }

    .panel {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px;
    }

    .panel-title {
        font-size: 1.3rem;
        margin-bottom: 20px;
    }

    .description-text {
        margin-bottom: 24px;
    }

    .form-label-sm {
        font-size: .72rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 11px 14px;
        background: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(111,143,78,.15);
        }

    textarea.form-control {
        resize: vertical;
    }

    .timeline-item {
        display: flex;
        gap: 12px;
        padding-bottom: 18px;
    }

    .timeline-dot {
        width: 8px;
        height: 8px;
        background: #cfc9b8;
        border-radius: 50%;
        margin-top: 6px;
        flex-shrink: 0;
    }

    .timeline-text {
        font-weight: 500;
    }

    .timeline-meta {
        font-size: .8rem;
        color: var(--muted);
        margin-top: 2px;
    }

    .comment-box {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

    .comment-input {
        flex: 1;
    }

    .modal-content {
        background: var(--card-bg);
        border-radius: 20px;
        border: none;
        padding: 8px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border);
        padding: 20px 26px 16px;
    }

    .modal-body {
        padding: 22px 26px;
    }

    .modal-footer {
        border-top: 1px solid var(--border);
        padding: 16px 26px 22px;
    }

    .modal-eyebrow {
        font-size: .72rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent-dark);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
    }

        .modal-eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

    .modal-title-lg {
        font-size: 1.6rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .modal-desc {
        color: var(--muted);
        font-size: .88rem;
    }

    .hint-note {
        font-size: .8rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
    }

        .hint-note .dot {
            width: 5px;
            height: 5px;
            background: var(--accent);
            border-radius: 50%;
        }
</style>

<div class="request-page">

    <a asp-controller="Request" asp-action="Index" class="back-link">&lsaquo; BACK TO REQUESTS</a>

    <div class="eyebrow"><span class="dot"></span> REQUEST &middot; @Model.Request?.Priority</div>

    <div class="page-header">
        <div>
            <h1 class="page-title">@Model.Request?.Title</h1>
            <div class="page-subtitle">Client: @Model.Request?.Customer &middot; created @Model.Request?.CreatedAt.ToString("dd/MM/yy") &middot; updated @Model.Request?.UpdatedAt.ToString("dd/MM/yy")</div>
        </div>
        <button type="button" class="btn btn-ghost" data-bs-toggle="modal" data-bs-target="#editRequestModal">Edit</button>
    </div>

    <form asp-controller="Request" asp-action="ChangeStatus" asp-route-id="@Model.Request?.Id" method="post" class="status-tabs">
        <button type="submit" name="status" value="New"
                class="status-pill @(Model.Request?.Status.ToString() == "New" ? "active" : "")">
            New
        </button>
        <button type="submit" name="status" value="Active"
                class="status-pill @(Model.Request?.Status.ToString() == "Active" ? "active" : "")">
            Active
        </button>
        <button type="submit" name="status" value="Finished"
                class="status-pill @(Model.Request?.Status.ToString() == "Finished" ? "active" : "")">
            Finished
        </button>
        <button type="submit" name="status" value="Solved"
                class="status-pill @(Model.Request?.Status.ToString() == "Solved" ? "active" : "")">
            Solved
        </button>
        <button type="submit" name="status" value="Rejected"
                class="status-pill @(Model.Request?.Status.ToString() == "Rejected" ? "active" : "")">
            Rejected
        </button>
    </form>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="panel">
                <div class="panel-title">Description</div>

                <div class="description-text">@Model.Request?.Description</div>

                <div class="form-label-sm">Responsible Manager</div>
                <select class="form-select" disabled>
                    @foreach (var m in Model.Managers)
                    {
                        <option value="@m.Value" selected="@(m.Text == Model.Request?.Manager)">@m.Text</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="panel">
                <div class="panel-title">History &amp; Comments</div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>
                    <div>
                        <div class="timeline-text">Status changed to "New".</div>
                        <div class="timeline-meta">You &middot; 01.09.2026</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>
                    <div>
                        <div class="timeline-text">Status changed to "Closed".</div>
                        <div class="timeline-meta">You &middot; 01.09.2026</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>
                    <div>
                        <div class="timeline-text">Status changed to "Resolved".</div>
                        <div class="timeline-meta">You &middot; 01.09.2026</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>
                    <div>
                        <div class="timeline-text">Status changed to "In Progress".</div>
                        <div class="timeline-meta">Ana Moraru &middot; 30.08.2026 09:00</div>
                    </div>
                </div>

                <div class="timeline-item">
                    <span class="timeline-dot"></span>
                    <div>
                        <div class="timeline-text">Request created.</div>
                        <div class="timeline-meta">System &middot; 25.08.2026 13:20</div>
                    </div>
                </div>

                <div class="comment-box">
                    <input type="text" class="form-control comment-input" placeholder="Add a comment..." />
                    <button type="button" class="btn btn-cancel">Add</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Request" asp-action="Update" asp-route-id="@Model.Request?.Id" method="post">
                <div class="modal-header">
                    <div>
                        <div class="modal-eyebrow"><span class="dot"></span> EDITING</div>
                        <div class="modal-title-lg">Edit Request</div>
                        <div class="modal-desc">Client inquiry to be handled by a manager.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <input type="hidden" name="Id" value="@Model.Request?.Id" />
                        <div class="col-12">
                            <div class="form-label-sm">Client *</div>
                            <select name="CustomerId" class="form-select">
                                @foreach (var c in Model.Customers)
                                {
                                    <option value="@c.Value" selected="@(c.Text == Model.Request?.Customer)">@c.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-label-sm">Subject *</div>
                            <input type="text" name="Title" class="form-control" value="@Model.Request?.Title" />
                        </div>
                        <div class="col-12">
                            <div class="form-label-sm">Description</div>
                            <textarea name="Description" class="form-control" rows="3">@Model.Request?.Description</textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="form-label-sm">Priority</div>
                            <select name="Priority" class="form-select">
                                <option value="0" selected="@(Model.Request?.Priority.ToString() == "Low")">Low</option>
                                <option value="1" selected="@(Model.Request?.Priority.ToString() == "Medium")">Medium</option>
                                <option value="2" selected="@(Model.Request?.Priority.ToString() == "High")">High</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="form-label-sm">Manager</div>
                            <select name="ManagerId" class="form-select">
                                @foreach (var m in Model.Managers)
                                {
                                    <option value="@m.Value" selected="@(m.Text == Model.Request?.Manager)">@m.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="hint-note"><span class="dot"></span> Status stays unchanged when editing details</div>
                </div>
                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Save Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

