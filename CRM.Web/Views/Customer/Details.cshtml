@model CustomerDetailsViewModel;

@{
    ViewData["Title"] = $"{@Model.Customer?.Name}";
}

<style>
    :root {
        --bg: #f6f2e9;
        --card-bg: #faf8f2;
        --border: #e6e0d2;
        --ink: #2b2a26;
        --muted: #8a8578;
        --accent-dark: #55712f;
        --badge-new-bg: #e7e6f7;
        --badge-new-fg: #5b57c9;
        --badge-progress-bg: #f4e6c9;
        --badge-progress-fg: #93711b;
        --badge-resolved-bg: #e3ecd9;
        --badge-resolved-fg: #4b7a5a;
        --blue-bg: #e7e6f7;
        --blue: #5b57c9;
    }

    body {
        background: var(--bg);
        color: var(--ink);
    }

    .client-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 2px 24px 80px;
    }

    .back-link {
        font-size: .78rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
    }

        .back-link:hover {
            color: var(--ink);
        }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .75rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent-dark);
        margin: 20px 0 6px;
    }

        .eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
            display: inline-block;
        }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 2.4rem;
        font-weight: 600;
        margin: 0;
    }

    .page-subtitle {
        color: var(--muted);
        font-size: .95rem;
        margin-top: 4px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
    }

    .btn-ghost {
        background: #fff;
        border: 1px solid var(--border);
        color: var(--ink);
        border-radius: 999px;
        padding: 10px 20px;
        font-size: .9rem;
        font-weight: 500;
    }

        .btn-ghost:hover {
            background: #f1ede2;
            color: var(--ink);
        }

    .btn-dark {
        background: #1c1b18;
        border: none;
        color: #fff;
        border-radius: 999px;
        padding: 10px 22px;
        font-size: .9rem;
        font-weight: 500;
    }

        .btn-dark:hover {
            background: #000;
            color: #fff;
        }

    .btn-accent {
        background: var(--accent);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 600;
    }

        .btn-accent:hover {
            background: var(--accent-dark);
            color: #fff;
        }

    .btn-cancel {
        background: #ece7d8;
        border: none;
        color: var(--ink);
        border-radius: 10px;
        padding: 10px 22px;
        font-weight: 500;
    }

        .btn-cancel:hover {
            background: #e2ddcb;
        }

    .panel {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 28px;
    }

    .panel-title {
        font-size: 1.3rem;
        margin-bottom: 20px;
    }

    .info-label {
        font-size: .68rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .info-value {
        font-weight: 600;
        margin-bottom: 18px;
    }

    .ticket-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 4px;
        border-top: 1px solid var(--border);
    }

        .ticket-row:first-of-type {
            border-top: none;
        }

    .ticket-title {
        font-weight: 600;
        margin-bottom: 2px;
    }

    .ticket-client {
        font-size: .82rem;
        color: var(--muted);
    }

    .ticket-date {
        text-align: right;
        font-size: .85rem;
        color: var(--ink);
        min-width: 96px;
    }

    .ticket-updated {
        font-size: .72rem;
        color: var(--muted);
    }

    .badge-status {
        font-size: .75rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 5px 12px;
        white-space: nowrap;
    }

    .badge-new {
        background: var(--badge-new-bg);
        color: var(--badge-new-fg);
    }

    .badge-progress {
        background: var(--badge-progress-bg);
        color: var(--badge-progress-fg);
    }

    .badge-resolved {
        background: var(--badge-resolved-bg);
        color: var(--badge-resolved-fg);
    }

    .request-date {
        text-align: right;
        font-size: .85rem;
        color: var(--ink);
        min-width: 96px;
    }

        .request-date small {
            display: block;
            color: var(--muted);
            font-size: .72rem;
        }

    .modal-content {
        background: var(--card-bg);
        border-radius: 20px;
        border: none;
        padding: 8px;
    }

    .modal-header {
        border-bottom: 1px solid var(--border);
        padding: 20px 26px 16px;
    }

    .modal-body {
        padding: 22px 26px;
    }

    .modal-footer {
        border-top: 1px solid var(--border);
        padding: 16px 26px 22px;
    }

    .modal-eyebrow {
        font-size: .72rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--accent-dark);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
    }

        .modal-eyebrow .dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
        }

    .modal-title-lg {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .modal-desc {
        color: var(--muted);
        font-size: .88rem;
    }

    .form-label-sm {
        font-size: .72rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 11px 14px;
        background: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(111,143,78,.15);
        }

    textarea.form-control {
        resize: vertical;
    }

    .hint-note {
        font-size: .8rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
    }

        .hint-note .dot {
            width: 5px;
            height: 5px;
            background: var(--accent);
            border-radius: 50%;
        }

    .ticket-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: var(--blue-bg);
        color: var(--blue);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .ticket-icon svg {
            width: 16px;
            height: 16px;
        }

    .empty-state {
        padding: 2.5rem 1.4rem;
        text-align: center;
        color: var(--muted);
    }

        .empty-state svg {
            width: 32px;
            height: 32px;
            color: var(--muted);
            margin-bottom: .75rem;
        }

        .empty-state .empty-title {
            font-weight: 600;
            color: var(--ink);
            margin-bottom: .25rem;
        }

        .empty-state .empty-sub {
            font-size: .85rem;
        }

    .badge-status {
        font-size: .75rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 5px 12px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .badge-status .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
            background: currentColor;
        }

    .badge-new {
        background: var(--badge-new-bg);
        color: var(--badge-new-fg);
    }

    .badge-progress {
        background: var(--badge-progress-bg);
        color: var(--badge-progress-fg);
    }

    .badge-resolved {
        background: var(--badge-resolved-bg);
        color: var(--badge-resolved-fg);
    }

    #newRequestModal .modal-content {
        background: var(--bg);
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #newRequestModal .modal-header-custom {
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid var(--border);
        position: relative;
    }

    #newRequestModal .modal-title-custom {
        font-weight: 500;
        font-size: 1.6rem;
        margin: 0 0 .3rem;
    }

    #newRequestModal .modal-subtitle {
        color: var(--muted);
        font-size: .9rem;
    }

    #newRequestModal .modal-close-btn {
        position: absolute;
        top: 1.25rem;
        right: 1.5rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #ebe8e0;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #newRequestModal .modal-close-btn:hover {
            background: #e0ddd3;
        }

    #newRequestModal .modal-body {
        padding: 1.5rem 1.75rem;
    }

    #newRequestModal .field-label {
        font-size: .72rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        margin-bottom: .5rem;
        display: block;
    }

        #newRequestModal .field-label .req {
            color: var(--badge-progress-fg);
        }

    #newRequestModal .form-control,
    #newRequestModal .form-select {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: .65rem .9rem;
        font-size: .92rem;
        color: var(--ink);
    }

        #newRequestModal .form-control:focus,
        #newRequestModal .form-select:focus {
            border-color: var(--accent-dark);
            box-shadow: 0 0 0 3px rgba(111,143,78,.15);
        }

    #newRequestModal textarea.form-control {
        resize: vertical;
        min-height: 90px;
    }

    #newRequestModal .field-group {
        margin-bottom: 1.25rem;
    }

    #newRequestModal .hint-note {
        font-size: .82rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        #newRequestModal .hint-note .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-dark);
            display: inline-block;
            flex-shrink: 0;
        }

    #newRequestModal .modal-footer-custom {
        padding: 1.1rem 1.75rem;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

    #newRequestModal .btn-cancel {
        background: #ece7d8;
        color: var(--ink);
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
    }

        #newRequestModal .btn-cancel:hover {
            background: #e2ddcb;
        }

    #newRequestModal .btn-save {
        background: var(--accent-dark);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
        font-weight: 500;
    }

        #newRequestModal .btn-save:hover {
            background: #445c25;
        }
</style>

<div class="client-page">

    <a class="back-link" asp-controller="Customer" asp-action="Index">&lsaquo; BACK TO CLIENTS</a>

    <div class="page-header">
        <div>
            <h1 class="page-title">@Model.Customer?.Name</h1>
            <div class="page-subtitle">@Model.Customer?.ContactPerson &middot; client since @Model.Customer?.CreatedAt.ToString("dd/MM/yyyy")</div>
        </div>
        <div class="header-actions">
            <button type="button" class="btn btn-ghost" data-bs-toggle="modal" data-bs-target="#editClientModal">Edit</button>
            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#newRequestModal">+ New Request</button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="panel">
                <div class="panel-title">Information</div>

                <div class="info-label">Contact Person</div>
                <div class="info-value">@Model.Customer?.ContactPerson</div>

                <div class="info-label">Phone</div>
                <div class="info-value">@Model.Customer?.Telephone</div>

                <div class="info-label">Email</div>
                <div class="info-value">@Model.Customer?.Email</div>

                <div class="info-label">Client Since</div>
                <div class="info-value">@Model.Customer?.CreatedAt.ToString("dd/MM/yyyy")</div>

                <div class="info-label">Comment</div>
                <div class="info-value mb-0">@Model.Customer?.Comment</div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="panel">
                <div class="panel-title">Client Requests</div>

                @if (Model.Customer?.Requests != null && Model.Customer?.Requests.Count > 0)
                {
                    @foreach (var request in Model.Customer.Requests)
                    {
                        <div class="ticket-row">
                            <span class="ticket-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6M9 16h6M9 8h1" /><path d="M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /></svg>
                            </span>
                            <div class="flex-grow-1">
                                <div class="ticket-title">@request.Title</div>
                                <div class="ticket-client">@request.Manager</div>
                            </div>
                            <span class="badge-status"><span class="dot"></span>@request.Status</span>
                            <div class="ticket-date">
                                @request.UpdatedAt.ToString("dd/MM/yyyy")
                                <div class="ticket-updated">updated</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6M9 16h6M9 8h1" /><path d="M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" /></svg>
                        <div class="empty-title">No requests yet</div>
                        <div class="empty-sub">New requests will show up here as they come in.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editClientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-controller="Customer" asp-action="Update" asp-route-id="@Model.Customer?.Id">
                <div class="modal-header">
                    <div>
                        <div class="modal-eyebrow"><span class="dot"></span> EDITING</div>
                        <div class="modal-title-lg">Edit Client</div>
                        <div class="modal-desc">Client card for mini-CRM.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <input type="hidden" name="Id" value="@Model.Customer?.Id" />
                        <div class="col-12">
                            <div class="form-label-sm">Company Name *</div>
                            <input type="text" name="Name" class="form-control" value="@Model.Customer?.Name" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-label-sm">Contact Person</div>
                            <input type="text" name="ContactPerson" class="form-control" value="@Model.Customer?.ContactPerson" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-label-sm">Phone</div>
                            <input type="text" name="Telephone" class="form-control" value="@Model.Customer?.Telephone" />
                        </div>
                        <div class="col-12">
                            <div class="form-label-sm">Email</div>
                            <input type="email" name="Email" class="form-control" value="@Model.Customer?.Email" />
                        </div>
                        <div class="col-12">
                            <div class="form-label-sm">Comment</div>
                            <textarea name="Comment" class="form-control" rows="3">@Model.Customer?.Comment</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Save Client</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="newRequestModal" tabindex="-1" aria-labelledby="newRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="eyebrow"><span class="dot"></span>New request</div>
                <div class="modal-title-custom" id="newRequestModalLabel">New request</div>
                <div class="modal-subtitle">Customer inquiry for a manager to process.</div>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <form method="post" asp-controller="Request" asp-action="Create">
                <div class="modal-body">

                    <div class="field-group">
                        <label class="field-label" for="reqClient">Client <span class="req">*</span></label>
                        <select class="form-select" id="reqClient" name="CustomerId" asp-items="Model.Customers" required>
                            <option value="">Select a client</option>
                        </select>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="reqSubject">Subject <span class="req">*</span></label>
                        <input type="text" class="form-control" id="reqSubject" name="Title" placeholder="Ex: Question about invoice" required />
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="reqDescription">Description</label>
                        <textarea class="form-control" id="reqDescription" name="Description" placeholder="Details of the inquiry..."></textarea>
                    </div>

                    <div class="row g-3 field-group">
                        <div class="col-6">
                            <label class="field-label" for="reqPriority">Priority</label>
                            <select class="form-select" id="reqPriority" name="Priority">
                                <option value="0">Low</option>
                                <option value="1" selected>Medium</option>
                                <option value="2">High</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="field-label" for="reqManager">Manager</label>
                            <select class="form-select" id="reqManager" name="ManagerId" asp-items="Model.Managers">
                                <option value="">Select a manager</option>
                            </select>
                        </div>
                    </div>

                    <div class="hint-note">
                        <span class="dot"></span>
                        New requests automatically get the "New" status
                    </div>

                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-save">Save request</button>
                </div>
            </form>

        </div>
    </div>
</div>