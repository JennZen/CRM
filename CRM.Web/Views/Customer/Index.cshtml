@{
    ViewData["Title"] = "Customers";
}
<style>
    :root {
        --bg: #f2efe8;
        --card: #ffffff;
        --ink: #1c1b19;
        --muted: #7a766e;
        --line: #e7e2d8;
        --green: #4b7a5a;
        --green-bg: #e6efe4;
        --amber: #a9812f;
        --amber-bg: #f4ecd8;
        --blue-bg: #e8ecf5;
        --blue: #4a5a8a;
    }

    body {
        background: var(--bg);
        color: var(--ink);
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--green);
        font-weight: 600;
        margin-bottom: .5rem;
    }

        .eyebrow .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
        }

    .page-title {
        font-weight: 500;
        font-size: 2.1rem;
    }

    .subtitle {
        color: var(--muted);
        font-size: .95rem;
    }

    .search-box-page {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .5rem .9rem;
        min-width: 260px;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .search-box-page input {
            border: none;
            outline: none;
            background: transparent;
            font-size: .88rem;
            width: 100%;
            color: var(--ink);
        }

        .search-box-page svg {
            width: 15px;
            height: 15px;
            color: var(--muted);
            flex-shrink: 0;
        }

    .btn-dark-soft {
        background: #1c1b19;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-size: .9rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        white-space: nowrap;
    }

        .btn-dark-soft:hover {
            background: #000;
            color: #fff;
        }

    .client-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        height: 100%;
    }

    .client-name {
        font-weight: 500;
        font-size: 1.3rem;
        margin: 0 0 .3rem;
    }

    .client-contact {
        font-size: .85rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: 1rem;
    }

        .client-contact svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

    .badge-status {
        font-size: .76rem;
        font-weight: 500;
        padding: .3rem .65rem;
        border-radius: 999px;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .badge-status .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: .35rem;
        }

    .badge-active {
        background: var(--amber-bg);
        color: var(--amber);
    }

        .badge-active .dot {
            background: var(--amber);
        }

    .badge-none {
        background: var(--green-bg);
        color: var(--green);
    }

        .badge-none .dot {
            background: var(--green);
        }

    .contact-chip {
        font-size: .8rem;
        border-radius: 8px;
        padding: .4rem .7rem;
        display: inline-block;
    }

    .chip-email {
        background: var(--green-bg);
        color: var(--green);
    }

    .chip-phone {
        background: #f0eee8;
        color: var(--ink);
    }

    .client-stats {
        border-top: 1px solid var(--line);
        padding-top: 1rem;
        margin-top: 1rem;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

        .client-stats .stat {
            text-align: center;
        }

        .client-stats .stat-num {
            font-size: 1.5rem;
            font-weight: 500;
            line-height: 1;
        }

            .client-stats .stat-num.amber {
                color: var(--amber);
            }

        .client-stats .stat-label {
            font-size: .68rem;
            letter-spacing: .04em;
            text-transform: lowercase;
            color: var(--muted);
            margin-top: .3rem;
        }

        .client-stats .stat-date {
            font-size: .9rem;
            text-align: right;
        }

            .client-stats .stat-date .stat-label {
                text-align: right;
            }
</style>

