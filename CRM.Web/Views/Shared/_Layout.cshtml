<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CRM.Web.styles.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-w: 240px;
            --header-h: 68px;
            --sidebar-bg: #14161a;
            --sidebar-bg-2: #1c1e24;
            --accent: #8bc34a;
            --accent-soft: #1f2a1a;
            --page-bg: #f5f4ef;
            --header-bg: #d4d2c8;
        }

        body {
            background: var(--page-bg);
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-w);
            height: 100vh;
            overflow-y: auto;
            background: var(--sidebar-bg);
            color: #cfd2d6;
            z-index: 1030;
        }

            .sidebar .logo-badge {
                width: 42px;
                height: 42px;
                background: var(--accent);
                border-radius: .6rem;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #14161a;
                font-weight: 700;
                flex-shrink: 0;
            }

                .sidebar .logo-badge img.logo-img {
                    width: 34px;
                    height: 34px;
                    object-fit: contain;
                    border-radius: .4rem;
                }

            .sidebar .brand {
                color: #fff;
                font-weight: 600;
            }

            .sidebar .brand-logo {
                width: 38px;
                height: 38px;
                border-radius: .6rem;
                object-fit: contain;
            }

            .sidebar .brand-sub {
                color: #6b7076;
                font-size: .72rem;
            }

            .sidebar .section-label {
                text-transform: uppercase;
                font-size: .68rem;
                letter-spacing: .06em;
                color: #6b7076;
            }

            .sidebar .nav-link {
                color: #cfd2d6;
                border-radius: .6rem;
                padding: .6rem .9rem;
                transition: background .15s ease, color .15s ease;
            }

                .sidebar .nav-link:hover {
                    color: #fff;
                    background: var(--sidebar-bg-2);
                }

                .sidebar .nav-link.active {
                    background: var(--accent-soft);
                    color: #fff;
                    border: 1px solid rgba(139, 195, 74, .5);
                }

            .sidebar .badge-count {
                background: var(--accent);
                color: #14161a;
                font-weight: 600;
            }

            .sidebar .user-card {
                background: var(--sidebar-bg-2);
                border-radius: .75rem;
                padding: .6rem .7rem;
                flex-shrink: 0;
            }

        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-w);
            right: 0;
            height: var(--header-h);
            background: var(--header-bg);
            border-bottom: 1px solid rgba(0,0,0,.06);
            padding: 0 1.5rem;
            z-index: 1020;
        }

            .topbar .breadcrumb-text {
                font-size: .9rem;
                color: #6b7076;
            }

                .topbar .breadcrumb-text strong {
                    color: #14161a;
                }

            .topbar .search-box {
                background: #fff;
                border-radius: .75rem;
                border: 1px solid rgba(0,0,0,.08);
                padding: .45rem .9rem;
                min-width: 320px;
            }

                .topbar .search-box input {
                    border: none;
                    outline: none;
                    background: transparent;
                    font-size: .88rem;
                    width: 100%;
                }

            .topbar .live-badge {
                background: var(--accent-soft);
                color: #4b7a1f;
                font-size: .78rem;
                font-weight: 600;
                border-radius: 999px;
                padding: .35rem .8rem;
                display: inline-flex;
                align-items: center;
                gap: .4rem;
            }

                .topbar .live-badge .dot {
                    width: 7px;
                    height: 7px;
                    border-radius: 50%;
                    background: var(--accent);
                    display: inline-block;
                }

        .content-col {
            margin-left: var(--sidebar-w);
            padding-top: var(--header-h);
            min-height: 100vh;
        }

        @@media (max-width: 767.98px) {
            .sidebar {
                position: static;
                width: 100%;
                height: auto;
            }

            .topbar {
                position: static;
                left: 0;
                height: auto;
                padding: .85rem 1.5rem;
            }

            .content-col {
                margin-left: 0;
                padding-top: 0;
            }
        }
    </style>
</head>
<body>
    <nav class="sidebar d-flex flex-column p-3">

        <div class="d-flex align-items-center mb-4">
            <div class="logo-badge me-2">
                <img src="~/images/logo.png" alt="INTELECTSOFT logo" class="logo-img" />
            </div>
            <div>
                <div class="brand">Mini CRM</div>
                <div class="brand-sub">by INTELECTSOFT</div>
            </div>
        </div>

        <div class="section-label mb-2">Overview</div>
        <ul class="nav nav-pills flex-column mb-4">
            <li class="nav-item">
                <a class="nav-link active" href="#">
                    <i class="bi bi-grid me-2"></i>Dashboard
                </a>
            </li>
        </ul>

        <div class="section-label mb-2">Workspace</div>
        <ul class="nav nav-pills flex-column">
            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between" href="#">
                    <span><i class="bi bi-people me-2"></i>Customers</span>
                    <span class="badge rounded-pill badge-count">5</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex justify-content-between" href="#">
                    <span><i class="bi bi-file-earmark-text me-2"></i>Requests</span>
                    <span class="badge rounded-pill badge-count">5</span>
                </a>
            </li>
        </ul>

        <div class="mt-auto pt-3">
            <div class="user-card d-flex align-items-center">
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-2"
                     style="width:36px;height:36px;">
                    AM
                </div>
                <div class="small">
                    <div class="fw-semibold text-white">Ana Moraru</div>
                    <div class="text-secondary">Manager</div>
                </div>
            </div>
        </div>
    </nav>

    <header class="topbar d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-4">
            <div class="breadcrumb-text">
                INTELECTSOFT · Mini CRM / <strong>Dashboard</strong>
            </div>
            <div class="search-box d-flex align-items-center">
                <i class="bi bi-search me-2 text-secondary"></i>
                <input type="text" placeholder="Search customer or request..." />
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary">@User.Identity.Name</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-dark">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                </div>
            }

            <span class="live-badge">
                <span class="dot"></span>LIVE · 3
            </span>
        </div>
    </header>

    <div class="content-col">
        <main class="p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
