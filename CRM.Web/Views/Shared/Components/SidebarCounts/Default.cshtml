@model SidebarCountsViewModel

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <a class="nav-link d-flex justify-content-between @(Model.CurrentController.Equals("Customer", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
           asp-controller="Customer" asp-action="Index">
            <span><i class="bi bi-people me-2"></i>Clients</span>
            <span class="badge rounded-pill badge-count">@Model.CustomersCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex justify-content-between @(Model.CurrentController.Equals("Request", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
           asp-controller="Request" asp-action="Index">
            <span><i class="bi bi-file-earmark-text me-2"></i>Requests</span>
            <span class="badge rounded-pill badge-count">@Model.RequestsCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex justify-content-between @(Model.CurrentController.Equals("User", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
           asp-controller="User" asp-action="Index">
            <span><i class="bi bi-person-badge me-2"></i>Users</span>
            <span class="badge rounded-pill badge-count">@Model.UserCount</span>
        </a>
    </li>
</ul>