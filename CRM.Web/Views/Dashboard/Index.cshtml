@model DashboardViewModel;

@{
    ViewData["Title"] = "Dashboard";
}
<style>
    :root {
        --bg: #f2efe8;
        --card: #ffffff;
        --ink: #1c1b19;
        --muted: #7a766e;
        --line: #e7e2d8;
        --green: #4b7a5a;
        --green-bg: #e6efe4;
        --amber: #a9812f;
        --amber-bg: #f4ecd8;
        --blue-bg: #e8ecf5;
        --blue: #4a5a8a;
        --red: #a94b3f;
        --red-bg: #f4e2de;
        --gray: #6f6b64;
        --gray-bg: #eeece5;
    }

    body {
        background: var(--bg);
        color: var(--ink);
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--green);
        font-weight: 600;
        margin-bottom: .5rem;
    }

        .eyebrow .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
        }

    .page-title {
        font-weight: 500;
        font-size: 2.1rem;
    }

    .subtitle {
        color: var(--muted);
        font-size: .95rem;
    }

    .btn-outline-soft {
        background: var(--card);
        border: 1px solid var(--line);
        color: var(--ink);
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-size: .9rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .btn-outline-soft:hover {
            background: #f7f5f0;
            color: var(--ink);
        }

    .btn-dark-soft {
        background: #1c1b19;
        color: #fff;
        border-radius: 10px;
        padding: .55rem 1.1rem;
        font-size: .9rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .btn-dark-soft:hover {
            background: #000;
            color: #fff;
        }

    .stat-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.25rem 1.4rem;
        height: 100%;
    }

    .stat-label {
        font-size: .72rem;
        letter-spacing: .04em;
        color: var(--muted);
        text-transform: lowercase;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 500;
        margin: .25rem 0 .1rem;
    }

    .stat-sub {
        font-size: .82rem;
        color: var(--muted);
    }

    .icon-badge {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .icon-badge svg {
            width: 16px;
            height: 16px;
        }

        .icon-badge.green {
            background: var(--green-bg);
            color: var(--green);
        }

        .icon-badge.blue {
            background: var(--blue-bg);
            color: var(--blue);
        }

        .icon-badge.amber {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .icon-badge.gray {
            background: #ececec;
            color: #555;
        }

    .panel {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
    }

    .panel-header {
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .panel-header h2 {
            font-weight: 500;
            font-size: 1.25rem;
            margin: 0;
        }

        .panel-header .hint {
            font-size: .72rem;
            color: var(--muted);
            letter-spacing: .03em;
        }

    .link-btn {
        background: var(--bg);
        border: none;
        border-radius: 8px;
        padding: .4rem .9rem;
        font-size: .85rem;
        color: var(--ink);
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        gap: .35rem;
    }

        .link-btn:hover {
            background: #e9e5db;
        }

        .link-btn svg {
            width: 12px;
            height: 12px;
        }

    .ticket-row {
        padding: 1rem 1.4rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        gap: .9rem;
    }

        .ticket-row:last-child {
            border-bottom: none;
        }

    .ticket-id {
        font-size: .78rem;
        color: var(--muted);
        background: var(--bg);
        border-radius: 6px;
        padding: .2rem .5rem;
        min-width: 42px;
        text-align: center;
    }

    .ticket-title {
        font-weight: 600;
        font-size: .95rem;
        margin-bottom: 1px;
    }

    .ticket-client {
        font-size: .82rem;
        color: var(--muted);
    }

    .badge-status {
        font-size: .76rem;
        font-weight: 500;
        padding: .3rem .65rem;
        border-radius: 999px;
        white-space: nowrap;
    }

        .badge-status .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            margin-right: .35rem;
        }

    .badge-new {
        background: var(--blue-bg);
        color: var(--blue);
    }

        .badge-new .dot {
            background: var(--blue);
        }

    .badge-progress {
        background: var(--amber-bg);
        color: var(--amber);
    }

        .badge-progress .dot {
            background: var(--amber);
        }

    .badge-done {
        background: var(--green-bg);
        color: var(--green);
    }

        .badge-done .dot {
            background: var(--green);
        }

    .ticket-date {
        font-size: .85rem;
        text-align: right;
        min-width: 95px;
    }

    .ticket-updated {
        font-size: .72rem;
        color: var(--muted);
    }

    .manager-row {
        padding: .9rem 1.4rem;
        display: flex;
        align-items: center;
        gap: .8rem;
        border-bottom: 1px solid var(--line);
    }

        .manager-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 600;
        font-size: .85rem;
        flex-shrink: 0;
    }

    .manager-name {
        font-weight: 600;
        font-size: .92rem;
    }

    .manager-sub {
        font-size: .72rem;
        color: var(--muted);
    }

    .manager-count {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--green);
    }

    #newRequestModal .modal-content {
        background: var(--bg);
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #newRequestModal .modal-header-custom {
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid var(--line);
        position: relative;
    }

    #newRequestModal .modal-title-custom {
        font-weight: 500;
        font-size: 1.6rem;
        margin: 0 0 .3rem;
    }

    #newRequestModal .modal-subtitle {
        color: var(--muted);
        font-size: .9rem;
    }

    #newRequestModal .modal-close-btn {
        position: absolute;
        top: 1.25rem;
        right: 1.5rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #ebe8e0;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #newRequestModal .modal-close-btn:hover {
            background: #e0ddd3;
        }

    #newRequestModal .modal-body {
        padding: 1.5rem 1.75rem;
    }

    #newRequestModal .field-label {
        font-size: .72rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        margin-bottom: .5rem;
        display: block;
    }

        #newRequestModal .field-label .req {
            color: var(--red);
        }

    #newRequestModal .form-control,
    #newRequestModal .form-select {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .65rem .9rem;
        font-size: .92rem;
        color: var(--ink);
    }

        #newRequestModal .form-control:focus,
        #newRequestModal .form-select:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px var(--green-bg);
        }

    #newRequestModal textarea.form-control {
        resize: vertical;
        min-height: 90px;
    }

    #newRequestModal .field-group {
        margin-bottom: 1.25rem;
    }

    #newRequestModal .hint-note {
        font-size: .82rem;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        #newRequestModal .hint-note .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
            flex-shrink: 0;
        }

    #newRequestModal .modal-footer-custom {
        padding: 1.1rem 1.75rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

    #newRequestModal .btn-cancel {
        background: var(--gray-bg);
        color: var(--ink);
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
    }

        #newRequestModal .btn-cancel:hover {
            background: #e2ded3;
        }

    #newRequestModal .btn-save {
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
        font-weight: 500;
    }

        #newRequestModal .btn-save:hover {
            background: #3f6a4c;
        }

    #addClientModal .modal-content {
        background: var(--bg);
        border: none;
        border-radius: 16px;
        overflow: hidden;
    }

    #addClientModal .modal-header-custom {
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid var(--line);
        position: relative;
    }

    #addClientModal .modal-title-custom {
        font-weight: 500;
        font-size: 1.6rem;
        margin: 0 0 .3rem;
    }

    #addClientModal .modal-subtitle {
        color: var(--muted);
        font-size: .9rem;
    }

    #addClientModal .modal-close-btn {
        position: absolute;
        top: 1.25rem;
        right: 1.5rem;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #ebe8e0;
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #addClientModal .modal-close-btn:hover {
            background: #e0ddd3;
        }

    #addClientModal .modal-body {
        padding: 1.5rem 1.75rem;
    }

    #addClientModal .field-label {
        font-size: .72rem;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 600;
        margin-bottom: .5rem;
        display: block;
    }

        #addClientModal .field-label .req {
            color: var(--red);
        }

    #addClientModal .form-control {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .65rem .9rem;
        font-size: .92rem;
        color: var(--ink);
    }

        #addClientModal .form-control:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px var(--green-bg);
        }

    #addClientModal textarea.form-control {
        resize: vertical;
        min-height: 90px;
    }

    #addClientModal .field-group {
        margin-bottom: 1.25rem;
    }

    #addClientModal .modal-footer-custom {
        padding: 1.1rem 1.75rem;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
    }

    #addClientModal .btn-cancel {
        background: var(--gray-bg);
        color: var(--ink);
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
    }

        #addClientModal .btn-cancel:hover {
            background: #e2ded3;
        }

    #addClientModal .btn-save {
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .6rem 1.3rem;
        font-size: .9rem;
        font-weight: 500;
    }

        #addClientModal .btn-save:hover {
            background: #3f6a4c;
        }
</style>

<div class="container py-4" style="max-width:1200px;">

    <div class="d-flex flex-wrap justify-content-between align-items-start mb-4 gap-3">
        <div>
            <div class="eyebrow">
                <span class="dot"></span>Today &middot; @DateTime.Now.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
            </div>
            <div class="page-title">Good afternoon, @Model.UserFirstName</div>
            <div class="subtitle">@Model.NumberOfCustomers clients, @Model.TotalRequests requests, @Model.NumberOfManagers managers / admins on the team.</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn-outline-soft" data-bs-toggle="modal" data-bs-target="#addClientModal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                Add client
            </button>
            <button class="btn-dark-soft" type="button" data-bs-toggle="modal" data-bs-target="#newRequestModal">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M12 5v14M5 12h14" /></svg>
                New request
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label text-capitalize">CLIENTS</span>
                    <span class="icon-badge gray">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </span>
                </div>
                <div class="stat-value">@Model.NumberOfCustomers</div>
                <div class="stat-sub">active base</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label text-capitalize">NEW REQUESTS</span>
                    <span class="icon-badge blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 8v8M8 12h8" /></svg>
                    </span>
                </div>
                <div class="stat-value">@Model.NewRequests</div>
                <div class="stat-sub">need attention</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label text-capitalize">IN PROGRESS</span>
                    <span class="icon-badge amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                    </span>
                </div>
                <div class="stat-value">@Model.InProgressRequests</div>
                <div class="stat-sub">with managers</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="stat-label text-capitalize">COMPLETED</span>
                    <span class="icon-badge green">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                </div>
                <div class="stat-value">@Model.FinishedRequests</div>
                <div class="stat-sub">resolved and closed</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="panel h-100">
                <div class="panel-header">
                    <div>
                        <h2>Recent requests</h2>
                        <div class="hint">updated on activity</div>
                    </div>
                    <a asp-controller="Request" asp-action="Index" class="link-btn">
                        All requests
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                </div>

                <div class="ticket-row">
                    <span class="ticket-id">#T7</span>
                    <div class="flex-grow-1">
                        <div class="ticket-title">Error in client portal</div>
                        <div class="ticket-client">SC Vinia Trade</div>
                    </div>
                    <span class="badge-status badge-progress"><span class="dot"></span>In progress</span>
                    <div class="ticket-date">
                        08/30/2026
                        <div class="ticket-updated">updated</div>
                    </div>
                </div>

                <div class="ticket-row">
                    <span class="ticket-id">#T5</span>
                    <div class="flex-grow-1">
                        <div class="ticket-title">Product range expansion</div>
                        <div class="ticket-client">Bunatati Natural</div>
                    </div>
                    <span class="badge-status badge-new"><span class="dot"></span>New</span>
                    <div class="ticket-date">
                        08/29/2026
                        <div class="ticket-updated">updated</div>
                    </div>
                </div>

                <div class="ticket-row">
                    <span class="ticket-id">#T1</span>
                    <div class="flex-grow-1">
                        <div class="ticket-title">Order notifications not arriving</div>
                        <div class="ticket-client">Nord Logistic LLC</div>
                    </div>
                    <span class="badge-status badge-new"><span class="dot"></span>New</span>
                    <div class="ticket-date">
                        08/28/2026
                        <div class="ticket-updated">updated</div>
                    </div>
                </div>

                <div class="ticket-row">
                    <span class="ticket-id">#T4</span>
                    <div class="flex-grow-1">
                        <div class="ticket-title">Delayed shipment</div>
                        <div class="ticket-client">Agro Prim SRL</div>
                    </div>
                    <span class="badge-status badge-progress"><span class="dot"></span>In progress</span>
                    <div class="ticket-date">
                        08/27/2026
                        <div class="ticket-updated">updated</div>
                    </div>
                </div>

                <div class="ticket-row">
                    <span class="ticket-id">#T2</span>
                    <div class="flex-grow-1">
                        <div class="ticket-title">Contract renewal request</div>
                        <div class="ticket-client">Metaloprofil SRL</div>
                    </div>
                    <span class="badge-status badge-done"><span class="dot"></span>Done</span>
                    <div class="ticket-date">
                        08/25/2026
                        <div class="ticket-updated">updated</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel h-100">
                <div class="panel-header">
                    <h2>Requests by manager</h2>
                    <span class="hint text-end">total assigned</span>
                </div>

                <div class="manager-row">
                    <div class="avatar" style="background:#7fa06f;">AM</div>
                    <div class="flex-grow-1">
                        <div class="manager-name">Anna Morari</div>
                        <div class="manager-sub">Assigned requests</div>
                    </div>
                    <div class="manager-count">3</div>
                </div>

                <div class="manager-row">
                    <div class="avatar" style="background:#c98a5e;">VR</div>
                    <div class="flex-grow-1">
                        <div class="manager-name">Victor Railean</div>
                        <div class="manager-sub">Assigned requests</div>
                    </div>
                    <div class="manager-count">3</div>
                </div>

                <div class="manager-row">
                    <div class="avatar" style="background:#7b8bb0;">DK</div>
                    <div class="flex-grow-1">
                        <div class="manager-name">Dorin Cojocaru</div>
                        <div class="manager-sub">Assigned requests</div>
                    </div>
                    <div class="manager-count">2</div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="addClientModal" tabindex="-1" aria-labelledby="addClientModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header-custom">
                <div class="eyebrow"><span class="dot"></span>New client</div>
                <div class="modal-title-custom" id="addClientModalLabel">Add client</div>
                <div class="modal-subtitle">Client card for the mini-CRM.</div>
                <button type="button" class="modal-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M18 6 6 18M6 6l12 12" /></svg>
                </button>
            </div>

            <form asp-controller="Customer" asp-action="Create" method="post">
                <div class="modal-body">

                    <div class="field-group">
                        <label class="field-label" for="clientName">Company name <span class="req">*</span></label>
                        <input type="text" class="form-control" id="clientName" name=Name placeholder="Ex: Nord Logistic LLC" required />
                    </div>

                    <div class="row g-3 field-group">
                        <div class="col-6">
                            <label class="field-label" for="clientContact">Contact person</label>
                            <input type="text" class="form-control" id="clientContact" name=ContactPerson placeholder="Ex: Sergey Tkachuk" />
                        </div>
                        <div class="col-6">
                            <label class="field-label" for="clientPhone">Phone</label>
                            <input type="text" class="form-control" id="clientPhone" name=Telephone placeholder="+373 ..." />
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="clientEmail">Email</label>
                        <input type="email" class="form-control" id="clientEmail" name=Email placeholder="info@company.md" />
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="clientComment">Comment</label>
                        <textarea class="form-control" id="clientComment" name=Comment placeholder="Notes about working with this client..."></textarea>
                    </div>

                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
